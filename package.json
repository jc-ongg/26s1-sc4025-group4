{
  "name": "eatigo-group-dining",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace backend",
    "test:integration": "node scripts/check-auth.mjs",
    "format": "prettier --write \"*.{json,md,yml}\" \".prettierrc.json\" \"frontend/*.{json,ts,html}\" \"frontend/src/**/*.{ts,tsx,css}\" \"backend/*.{json,mjs}\" \"backend/src/**/*.ts\" \"docs/*.md\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"*.{json,md,yml}\" \".prettierrc.json\" \"frontend/*.{json,ts,html}\" \"frontend/src/**/*.{ts,tsx,css}\" \"backend/*.{json,mjs}\" \"backend/src/**/*.ts\" \"docs/*.md\" \"scripts/*.mjs\""
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
