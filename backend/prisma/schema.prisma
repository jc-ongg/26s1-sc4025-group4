generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(uuid())
  email              String               @unique
  name               String
  demoPassword       String
  reliabilityStrikes Int                  @default(0)
  singpassVerified   Boolean              @default(false)
  dateOfBirth        DateTime?            @db.Date
  gender             Gender?
  suspendedUntil     DateTime?
  diningArea         String               @default("")
  strikes            ReliabilityStrike[]
  notifications      Notification[]
  sentBlocks         DinerBlock[]         @relation("Blocker")
  receivedBlocks     DinerBlock[]         @relation("Blocked")
  messages           EventMessage[]
  feedback           EventFeedback[]
  reports            SafetyReport[]       @relation("ReportsSent")
  reportsAbout       SafetyReport[]       @relation("ReportsReceived")
  sessions           Session[]
  hostedGroups       GroupDiningSession[]
  memberships        GroupDiningMember[]
  bookings           Booking[]
  discoveryDecisions DiscoveryDecision[]
}

enum Gender {
  MALE
  FEMALE
}

model Restaurant {
  id              String                      @id
  name            String
  cuisine         String
  area            String
  description     String
  price           String
  artwork         String
  active          Boolean                     @default(true)
  address         String                      @default("")
  latitude        Float?
  longitude       Float?
  imagePath       String?
  imageSource     String?
  sourceUrl       String?
  sourceCheckedAt String?
  tags            String[]                    @default([])
  signatureDishes String[]                    @default([])
  embedding       Unsupported("vector(384)")?
  embeddingHash   String?
  slots           ReservationSlot[]
}

model ReservationSlot {
  id                 String               @id @default(uuid())
  restaurantId       String
  startsAt           DateTime
  minimumPartySize   Int
  capacity           Int
  discountedSeats    Int?
  eatTogetherEnabled Boolean              @default(true)
  discount           Int
  restaurant         Restaurant           @relation(fields: [restaurantId], references: [id])
  allocations        SlotAllocation[]
  groups             GroupDiningSession[]
  bookings           Booking[]

  @@unique([restaurantId, startsAt])
}

model SlotAllocation {
  id        String              @id @default(uuid())
  slotId    String
  seats     Int
  groupId   String?             @unique
  bookingId String?             @unique
  slot      ReservationSlot     @relation(fields: [slotId], references: [id])
  group     GroupDiningSession? @relation(fields: [groupId], references: [id])
  booking   Booking?            @relation(fields: [bookingId], references: [id])

  @@index([slotId])
}

enum GroupStatus {
  OPEN
  FULL
  CONFIRMED
  CANCELLED
  EXPIRED
  LAST_CALL
  PRICE_DECISION
  FULL_PRICE
}

model GroupDiningSession {
  id               String                      @id @default(uuid())
  hostId           String
  slotId           String
  title            String
  description      String                      @default("")
  genderFilter     Gender?
  minAge           Int?
  maxAge           Int?
  capacity         Int
  status           GroupStatus                 @default(OPEN)
  cutoffProcessed  Boolean                     @default(false)
  lastCallRound    Int                         @default(0)
  chatOpenedAt     DateTime?
  confirmedAt      DateTime?
  initialHeldSeats Int                         @default(0)
  releasedAtCutoff Int                         @default(0)
  createdAt        DateTime                    @default(now())
  embedding        Unsupported("vector(384)")?
  embeddingHash    String?
  host             User                        @relation(fields: [hostId], references: [id])
  slot             ReservationSlot             @relation(fields: [slotId], references: [id])
  members          GroupDiningMember[]
  allocation       SlotAllocation?
  booking          Booking?
  strikes          ReliabilityStrike[]
  notifications    Notification[]
  messages         EventMessage[]
  feedback         EventFeedback[]
  reports          SafetyReport[]
}

model DiscoveryDecision {
  userId    String
  targetKey String
  decision  String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, targetKey])
}

model GroupDiningMember {
  groupId       String
  userId        String
  partySize     Int                @default(1)
  joinedAt      DateTime           @default(now())
  priceAccepted Boolean            @default(false)
  group         GroupDiningSession @relation(fields: [groupId], references: [id])
  user          User               @relation(fields: [userId], references: [id])

  @@id([groupId, userId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Booking {
  id         String              @id @default(uuid())
  slotId     String
  userId     String
  groupId    String?             @unique
  partySize  Int
  discount   Int?
  deletedFor String[]            @default([])
  status     BookingStatus       @default(CONFIRMED)
  createdAt  DateTime            @default(now())
  slot       ReservationSlot     @relation(fields: [slotId], references: [id])
  user       User                @relation(fields: [userId], references: [id])
  group      GroupDiningSession? @relation(fields: [groupId], references: [id])
  allocation SlotAllocation?
}

model Session {
  token     String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model ReliabilityStrike {
  id        String             @id @default(uuid())
  userId    String
  groupId   String
  reason    String
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     GroupDiningSession @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId, reason])
  @@index([userId, createdAt])
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  groupId   String?
  key       String
  title     String
  body      String
  createdAt DateTime            @default(now())
  readAt    DateTime?
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     GroupDiningSession? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, createdAt])
}

model DinerBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}

model EventMessage {
  id        String             @id @default(uuid())
  groupId   String
  userId    String
  body      String
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     GroupDiningSession @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model EventFeedback {
  groupId     String
  userId      String
  overall     Int
  safety      String
  social      Int
  meal        Int
  dineAgain   String
  suggestions String             @default("")
  attended    Boolean
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  group       GroupDiningSession @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model SafetyReport {
  id         String             @id @default(uuid())
  groupId    String
  reporterId String
  targetId   String
  reason     String
  status     String             @default("PENDING")
  createdAt  DateTime           @default(now())
  reporter   User               @relation("ReportsSent", fields: [reporterId], references: [id], onDelete: Cascade)
  target     User               @relation("ReportsReceived", fields: [targetId], references: [id], onDelete: Cascade)
  group      GroupDiningSession @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([reporterId, createdAt])
}
