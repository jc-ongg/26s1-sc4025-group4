{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "test": "tsx --test src/auth.test.ts src/event-eligibility.test.ts",
    "test:integration": "tsx --test src/dining.test.ts src/lifecycle.test.ts",
    "generate": "prisma generate",
    "test:discovery": "tsx --test src/discovery.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@prisma/client": "^6.19.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
